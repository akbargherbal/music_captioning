# Models / weights (never commit)
models/
*.gguf

# Audio inputs and generated chunks (never commit)
audio/
*.mp3
*.wav
*.flac
*.m4a
*.ogg

# Demo output (regenerate with scripts/demo.py --out)
outputs/elisa.json

# Audio cache for batch runs (re-downloadable from GCS).
# The caption artefacts under work/yt500/ ARE tracked: chunk_captions and
# caption_raw are the expensive part of the pipeline, so committing them means a
# better polish model only re-runs the cheap phase. Audio, logs, tmp and the
# publish ledger stay out.
work/*
!work/yt500/
work/yt500/*
!work/yt500/captions/
!work/yt500/captions/**
!work/yt500/caption_album.json
!work/yt500/captions.jsonl

# Local scratch handed to a Colab session (prompts, notes, throwaway files)
local_workspace/

# Per-role worker logs (VM-local; re-creatable)
logs/

# Build artifacts
llama.cpp/
llama.cpp-text/
build/
*.o

# Secrets
.env
.env.*
*.token

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/

# OS / editors
.DS_Store
.idea/
.vscode/
